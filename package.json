{
  "name": "blindlens",
  "version": "1.1.1",
  "description": "Accessible screen descriptions with ChatGPT and spoken playback",
  "keywords": [
    "electron",
    "accessibility",
    "screen-reader",
    "chatgpt",
    "text-to-speech"
  ],
  "homepage": "https://github.com/bariskisir/BlindLens#readme",
  "bugs": "https://github.com/bariskisir/BlindLens/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bariskisir/BlindLens.git"
  },
  "main": "./out/main/index.js",
  "author": "bariskisir",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "start": "npm run build && electron .",
    "build": "npm run typecheck && vite build",
    "verify": "npm run lint && npm run test && npm run format:check && npm run build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "lint": "biome lint src tests vite.config.mts vitest.config.mts",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss,html}\" \"tests/**/*.{ts,tsx}\" \"*.{ts,mts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,scss,html}\" \"tests/**/*.{ts,tsx}\" \"*.{ts,mts}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && electron-builder --dir",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never && electron-builder --win nsis --arm64 --publish never",
    "package:win:x64": "npm run build && electron-builder --win nsis --x64 --publish never",
    "package:win:arm64": "npm run build && electron-builder --win nsis --arm64 --publish never",
    "package:mac": "npm run build && electron-builder --mac dmg --x64 --publish never && electron-builder --mac dmg --arm64 --publish never",
    "package:mac:x64": "npm run build && electron-builder --mac dmg --x64 --publish never",
    "package:mac:arm64": "npm run build && electron-builder --mac dmg --arm64 --publish never",
    "package:linux": "npm run build && electron-builder --linux --x64 --publish never && electron-builder --linux --arm64 --publish never",
    "package:linux:x64": "npm run build && electron-builder --linux --x64 --publish never",
    "package:linux:arm64": "npm run build && electron-builder --linux --arm64 --publish never",
    "release": "npm run package:win && npm run package:linux"
  },
  "dependencies": {
    "electron-log": "5.4.4",
    "uiohook-napi": "1.5.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@reduxjs/toolkit": "2.13.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "antd": "6.6.7",
    "electron": "43.8.3",
    "electron-builder": "26.18.0",
    "i18next": "26.5.10",
    "lucide-react": "1.61.0",
    "png-to-ico": "3.0.2",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.8",
    "react-redux": "9.3.0",
    "sass": "1.106.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-electron": "1.1.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "nanoid": "3.3.18"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.12.1",
  "build": {
    "appId": "com.bariskisir.blindlens",
    "productName": "BlindLens",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${name}-${version}-windows-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "differentialPackage": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "icon": "build/icon.png",
      "target": "dmg",
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "asarUnpack": [
      "node_modules/uiohook-napi/**/*"
    ]
  }
}
